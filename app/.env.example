# Both values are public by design. The anon key can only call the app's functions, which check who is asking.
# Supabase: Project Settings > API > Project URL and the anon public key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project pages are served from /<repo>/. Leave empty for a custom domain or local use.
NEXT_PUBLIC_BASE_PATH=
# Shown on the privacy and terms pages. Leave empty and the contact line is left out.
NEXT_PUBLIC_SUPPORT_EMAIL=
